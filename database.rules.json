{
  "rules": {
    "ironCrownV1": {
      "rooms": {
        "$room": {
          ".read": "auth != null && $room.matches(/^[0-9A-F]{12}$/)",
          ".write": "auth != null && $room.matches(/^[0-9A-F]{12}$/) && newData.exists() && ((!data.exists() && newData.child('owner').val() === auth.uid && !newData.child('members').exists()) || (data.exists() && newData.child('owner').val() === data.child('owner').val() && newData.child('members').child(auth.uid).isNumber() && (!data.child('members').child(auth.uid).exists() || newData.child('members').child(auth.uid).val() === data.child('members').child(auth.uid).val())))",
          ".validate": "newData.hasChildren(['owner','version','harvest','citizensAt','aiAt','players']) && newData.child('version').val() === 1 && newData.child('harvest').isNumber() && newData.child('citizensAt').isNumber() && newData.child('aiAt').isNumber() && newData.child('players').hasChildren(['0','1','2','3'])",
          "members": {
            "$uid": {
              ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1 || newData.val() === 2 || newData.val() === 3)"
            }
          }
        }
      },
      "presence": {
        "$room": {
          ".read": "auth != null && root.child('ironCrownV1/rooms').child($room).exists()",
          "$uid": {
            "$session": {
              ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('ironCrownV1/rooms').child($room).child('members').child(auth.uid).exists())",
              ".validate": "newData.hasChildren(['x','z','yaw','lift','crouch','at'])",
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= -92 && newData.val() <= 92"
              },
              "z": {
                ".validate": "newData.isNumber() && newData.val() >= -92 && newData.val() <= 92"
              },
              "yaw": {
                ".validate": "newData.isNumber() && newData.val() >= -3.15 && newData.val() <= 3.15"
              },
              "lift": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
              },
              "crouch": {
                ".validate": "newData.isBoolean()"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    }
  }
}
